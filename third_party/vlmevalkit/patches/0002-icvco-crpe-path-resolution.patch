+def _resolve_legacy_crpe_image_path(path):
+    marker = f'{os.sep}images{os.sep}CRPE{os.sep}'
+    if marker not in path or os.path.exists(path):
+        return path
+
+    candidates = (
+        path.replace(marker, f'{os.sep}images{os.sep}CRPE_EXIST{os.sep}', 1),
+        path.replace(marker, f'{os.sep}images{os.sep}CRPE_RELATION{os.sep}', 1),
+    )
+    for candidate in candidates:
+        if os.path.exists(candidate):
+            return candidate
+    return path
+
