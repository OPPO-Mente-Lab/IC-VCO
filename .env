# Local environment for IC-VCO scripts.
# Fill local paths or credentials here before running training/evaluation.
# Do not put a real API key into a committed public repository.

# VLMEvalKit checkout and benchmark cache.
# VLMEVALKIT_ROOT=/path/to/VLMEvalKit
# LMUData=/path/to/vlmeval_benchmarks

# OpenAI-compatible judge endpoint. For DashScope, keep the default API_BASE
# and set API_KEY to your DashScope API key.
API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# API_KEY=sk-...

# Existing DashScope-specific names are also supported.
# DASHSCOPE_OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# DASHSCOPE_API_KEY=sk-...
